---
import type { InferGetStaticParamsType } from "astro";
import Layout from "../../layouts/Layout.astro";
import { formatDate } from "../../utils";
import { getPost, getPosts } from "../../utils/sanity";
import { Marked } from "marked";
import markedFootnote from "marked-footnote";
import { Gallery } from "../../components/Gallery";
import { LinkButtons } from "../../components/LinkButtons";
import { stegaClean } from "@sanity/client/stega";
import { TypstError, typstHtml } from "../../utils/typst";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.slug.current },
  }));
}

type Params = InferGetStaticParamsType<typeof getStaticPaths>;
const { slug } = Astro.params as Params;

const post = await getPost(slug);

// Own instance so the footnote extension doesn't leak into the global `marked`
const md = new Marked().use(
  markedFootnote({ description: "Sources", headingClass: "" }),
);
let htmlContent: string;
let typstError: string | undefined;
const typst = stegaClean(post.format) === "typst";
if (typst) {
  try {
    htmlContent = await typstHtml(post);
  } catch (e) {
    if (!(e instanceof TypstError)) throw e;
    typstError = e.message;
    htmlContent = "";
  }
} else {
  htmlContent = md.parse(post.body ?? "") as string;
}

// LinkButtons labels `?dl=<file>` links as "Download <EXT>"
const links = [...(post.links ?? [])];
if (typst && post.pdf !== false) {
  links.push(new URL(`/post/${slug}.pdf?dl=${slug}.pdf`, Astro.url).href);
}
---

<Layout
  title={`${post.title} | vera.lgbt`}
  description={post.excerpt}
  tagged={post.tags?.map((t) => t._ref)}
>
  <article class="post">
    <header>
      <h1 class="post__title">{post.title}</h1>
      {post.excerpt && <p class="post__excerpt">{post.excerpt}</p>}
      <p class="post__date">{formatDate(post.date)}</p>
    </header>
    {
      post.gallery && (
        <div class="post__media">
          <Gallery gallery={post.gallery} client:load />
        </div>
      )
    }
    <LinkButtons links={links} />
    {typstError && <pre class="post__error">{typstError}</pre>}
    <div class="post__body prose" set:html={htmlContent} />
  </article>

  <style>
    .post {
      display: flex;
      flex-direction: column;
      gap: 2rem;
    }

    .post__title {
      font-size: 2rem;
      line-height: 1.15;
      font-weight: 700;
      letter-spacing: -0.02em;
    }

    .post__excerpt {
      margin-top: 0.75rem;
      font-size: 1.125rem;
      color: var(--muted-foreground);
    }

    .post__date {
      margin-top: 0.5rem;
      font-size: 0.875rem;
      color: var(--muted-foreground);
    }

    /* MathML never line-breaks; let a too-wide equation scroll instead of the page */
    .post__body {
      overflow-x: auto;
      scrollbar-width: thin;
      scrollbar-color: var(--border) transparent;
    }

    .post__error {
      white-space: pre-wrap;
      color: var(--destructive);
    }

    .post__media :global(img) {
      width: 100%;
      max-height: var(--media-h);
      object-fit: contain;
    }

    @media (min-width: 768px) {
      .post__title {
        font-size: 2.75rem;
      }
    }
  </style>
</Layout>
